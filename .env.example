# Public URL of the site (build time): absolute links for social previews. Dev: http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Chatbot LLM (utils/llm.js): llm7.io if LLM7_API_KEY is set, else/fallback OpenRouter if
# OPENROUTER_API_KEY is valid (checked for free via GET /key), else the AI assistant is disabled.
LLM7_API_KEY=
# models: leave empty to use the interface default (llm7 "default", OpenRouter "openrouter/auto")
LLM7_MODEL=
# LLM7_URL=https://api.llm7.io/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_URL=https://openrouter.ai/api/v1
# Local fallback: self-hosted OpenAI-compatible server (root docker-compose "llm" service, Gemma 4 E2B on CPU)
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=gemma-4-e2b
# Provider order (comma list of llm7, openrouter, local): local = self-hosted llama.cpp first, cloud as fallback
LLM_PROVIDER_ORDER=local,llm7,openrouter
# Legacy single endpoint: used only when LLM_BASE_URL points to api.llm7.io or openrouter.ai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT=60
# Retries per provider (429/5xx/timeout/empty answer) before redirecting; only before the first token
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=2
LLM_RETRY_MAX_DELAY=60
LLM_FAILURES_BEFORE_COOLDOWN=2
LLM_PROVIDER_COOLDOWN=300
